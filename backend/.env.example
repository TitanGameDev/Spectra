# Copy to .env and fill in with values from your Azure AD (Entra ID) App Registration
# for the BACKEND API (a separate registration from the frontend's client ID).
# Double underscores map to nested config sections (AzureAd:TenantId etc).
AzureAd__Instance=https://login.microsoftonline.com/
AzureAd__TenantId=
AzureAd__ClientId=

# Required only for the MSP customer-tenant features (Settings > Customers).
# This is a client secret on the BACKEND app registration, used for app-only
# (client-credentials) Graph calls against each customer's own tenant — not
# used for the delegated sign-in flow, which stays secret-free. The backend
# app registration must also be converted to multi-tenant and each customer's
# Entra admin must grant admin consent (see the README walkthrough) before
# collection against their tenant will succeed.
AzureAd__ClientSecret=

# Required only for the Email Security sub-tab (Exchange Online PowerShell
# checks — anti-phishing, Safe Links, Safe Attachments, anti-spam/anti-malware,
# DKIM, mail-flow rules). Uses the SAME backend app registration as above, but
# a certificate rather than the client secret (Exchange Online's app-only auth
# needs one). See the README's "Exchange Online security checks" section for
# how to generate this and which extra Application permissions to add.
Exo__CertificatePath=
Exo__CertificatePassword=

# Optional. Hours between automatic background collection runs for every
# customer (same collection manual "Collect data" triggers) — see
# CustomerSyncBackgroundService. Defaults to 6 if unset; set to 0 to disable
# automatic sync entirely and rely on manual collection only.
# Sync__IntervalHours=6

# Must match the frontend's dev origin so the popup-authenticated SPA can call this API.
# In production this must be set explicitly (the app refuses to start without it
# outside Development) — use your real https:// domain, e.g. https://app.example.com.
Cors__AllowedOrigin=http://localhost:5173

# Production only: bind Kestrel to loopback so it's only reachable through the
# nginx reverse proxy in deploy/nginx/spectra.conf, never directly from the internet.
# ASPNETCORE_URLS=http://127.0.0.1:5080

# Optional — powers the Settings > Updates panel. Only meaningful on a server
# set up by deploy/install.sh (which sets both automatically); leave unset
# for local dev, the panel just reports itself as unavailable. See the
# README's "One-click update" section.
# Update__DataDir=/var/lib/spectra
# Update__SrcDir=/opt/spectra/src

# SQLite database (users + admin group setting). Defaults to a local file next
# to the app if unset — fine for dev. In production, point this at a persistent,
# backed-up path (the file is gitignored, nothing here is committed).
# ConnectionStrings__Default=Data Source=/var/lib/spectra/spectra.db
