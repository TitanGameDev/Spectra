# Copy to .env for local dev. Azure AD (Entra ID) values — client IDs, tenant
# ID, API scope — are no longer set here at all. The frontend fetches them
# from the backend (/api/public/auth-config) at load time instead, which
# means they come from the database, set once through the setup wizard the
# app shows when unconfigured (or via deploy/setup-azure-ad.sh's auto-POST)
# and editable later from Settings -> Authentication.

# Backend API. In dev, the frontend and backend run on different ports, so this
# must be the full backend origin. In production behind the nginx config in
# deploy/nginx/spectra.conf, the API is reverse-proxied under the same domain —
# set this to "" (empty) so calls are same-origin and need no CORS at all.
VITE_API_BASE_URL=http://localhost:5080
