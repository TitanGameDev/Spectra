# Copy to .env and fill in with values from your Azure AD (Entra ID) App Registration.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
VITE_MSAL_REDIRECT_URI=http://localhost:5173

# Backend API
VITE_API_BASE_URL=http://localhost:5080
# The scope exposed by the backend API app registration, e.g. api://<backend-client-id>/access_as_user
VITE_API_SCOPE=
